{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "procurement-arena-scenario-v1",
  "type": "object",
  "required": ["schema_version", "scenario_id", "version", "seed", "timeline", "evidence", "truth"],
  "properties": {
    "schema_version": {"const": "procurement-arena-scenario-v1"},
    "scenario_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "tenant_id": {"type": "string", "minLength": 1},
    "timeline": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "date-time"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "truth": {"type": "object", "required": ["procurement_episode_id", "outcome"]}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "source_id", "event_date", "document_date", "verified_available_at", "observed_at"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "event_date": {"type": "string", "format": "date-time"},
        "document_date": {"type": "string", "format": "date-time"},
        "verified_available_at": {"type": "string", "format": "date-time"},
        "observed_at": {"type": "string", "format": "date-time"},
        "authority": {"type": "string"},
        "source_spans": {"type": "array", "items": {"type": "string"}},
        "entity_candidates": {"type": "array", "items": {"type": "string"}},
        "permission_scope": {"type": "string"},
        "contradictions": {"type": "array", "items": {"type": "string"}},
        "action_support": {"$ref": "#/$defs/actionSupportAttestation"}
      }
    },
    "actionSupportAttestation": {
      "type": "object",
      "required": ["procurement_episode_id", "action", "reviewer", "reviewed_at", "source_span", "rationale"],
      "properties": {
        "procurement_episode_id": {"type": "string", "minLength": 1},
        "action": {"enum": ["PREPARE", "BID_REVIEW"]},
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "source_span": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
