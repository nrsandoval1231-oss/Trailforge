{
  "name": "Trailforge Jade",
  "version": 1,
  "primitive": {
    "color": {
      "jade": {
        "700": "#126653",
        "800": "#104F42"
      },
      "graphite": {
        "900": "#232B26",
        "800": "#303A34"
      },
      "paper": {
        "50": "#F5F4EE",
        "100": "#EEF4EF",
        "200": "#E2EDE7"
      },
      "mint": {
        "400": "#70D1AE"
      },
      "brass": {
        "400": "#B49A60"
      },
      "slate": {
        "600": "#59645D",
        "500": "#707B73"
      },
      "error": {
        "800": "#8A3027",
        "100": "#FCECE9"
      }
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "20": "80px"
    },
    "radius": {
      "sm": "4px",
      "md": "8px",
      "lg": "12px",
      "pill": "999px"
    },
    "type": {
      "fontBody": "Manrope",
      "fontTechnical": "IBM Plex Mono",
      "body": "16px",
      "meta": "12px"
    }
  },
  "semantic": {
    "color": {
      "canvas": "{primitive.color.paper.50}",
      "canvasSubtle": "{primitive.color.paper.100}",
      "textPrimary": "{primitive.color.graphite.900}",
      "textSecondary": "{primitive.color.slate.600}",
      "textInverse": "{primitive.color.paper.50}",
      "action": "{primitive.color.jade.700}",
      "actionHover": "{primitive.color.jade.800}",
      "focus": "{primitive.color.jade.700}",
      "unknown": "{primitive.color.slate.600}",
      "verified": "{primitive.color.jade.700}",
      "review": "{primitive.color.graphite.900}",
      "error": "{primitive.color.error.800}",
      "disabled": "{primitive.color.slate.600}"
    },
    "dark": {
      "color": {
        "canvas": "#18221D",
        "canvasSubtle": "#232F29",
        "surface": "#28362E",
        "textPrimary": "#F5F4EE",
        "textSecondary": "#CAD4CC",
        "textInverse": "#232B26",
        "action": "#70D1AE",
        "actionHover": "#92E2C2",
        "focus": "#70D1AE",
        "unknown": "#D2DBD4",
        "verified": "#8BE0BE",
        "review": "#F0DDA9",
        "error": "#FFB6A9",
        "disabled": "#C1CAC2"
      }
    }
  },
  "component": {
    "buttonPrimary": {
      "background": "{semantic.color.action}",
      "foreground": "#FFFFFF",
      "hover": "{semantic.color.actionHover}",
      "focusRing": "{semantic.color.focus}",
      "disabledBackground": "#D9E1DA",
      "disabledForeground": "#59645D"
    },
    "badgeUnknown": {
      "background": "#EEF4EF",
      "foreground": "#59645D",
      "label": "UNKNOWN"
    },
    "badgeVerified": {
      "background": "#E2EDE7",
      "foreground": "#126653",
      "label": "VERIFIED"
    },
    "badgeNeedsReview": {
      "background": "#F3EEDF",
      "foreground": "#232B26",
      "label": "NEEDS REVIEW"
    },
    "badgeError": {
      "background": "#FCECE9",
      "foreground": "#8A3027",
      "label": "ERROR"
    },
    "buttonSecondary": {
      "background": "transparent",
      "foreground": "{semantic.color.textPrimary}",
      "border": "{primitive.color.slate.600}",
      "focusRing": "{semantic.color.focus}",
      "disabledBackground": "{primitive.color.paper.100}",
      "disabledForeground": "{semantic.color.disabled}"
    },
    "focus": {
      "color": "{semantic.color.focus}",
      "width": "3px",
      "offset": "2px"
    },
    "glass": {
      "tint": "#FFFFFF",
      "opacity": 0.92,
      "fallback": "#FFFFFF",
      "blur": "12px",
      "text": "#232B26"
    }
  },
  "contrast": [
    {
      "foreground": "#232B26",
      "background": "#F5F4EE",
      "ratio": 13.19,
      "use": "Primary text on warm paper; WCAG AA and AAA for normal text."
    },
    {
      "foreground": "#59645D",
      "background": "#F5F4EE",
      "ratio": 5.6,
      "use": "Secondary text on warm paper; WCAG AA for normal text."
    },
    {
      "foreground": "#59645D",
      "background": "#EEF4EF",
      "ratio": 5.53,
      "use": "Secondary text on mist; WCAG AA for normal text."
    },
    {
      "foreground": "#FFFFFF",
      "background": "#126653",
      "ratio": 6.88,
      "use": "Primary button and inverse text; WCAG AA for normal text."
    },
    {
      "foreground": "#F5F4EE",
      "background": "#232B26",
      "ratio": 13.19,
      "use": "Inverse text on graphite; WCAG AA and AAA for normal text."
    },
    {
      "foreground": "#70D1AE",
      "background": "#232B26",
      "ratio": 7.9,
      "use": "Mint accent and decorative emphasis on graphite; WCAG AA and AAA for normal text."
    },
    {
      "foreground": "#B49A60",
      "background": "#232B26",
      "ratio": 5.35,
      "use": "Brass labels on graphite; WCAG AA for normal text."
    },
    {
      "foreground": "#126653",
      "background": "#EEF4EF",
      "ratio": 6.17,
      "use": "Action links on mist; WCAG AA for normal text."
    },
    {
      "foreground": "#8A3027",
      "background": "#FCECE9",
      "ratio": 7.23,
      "use": "Error label and icon with text on pale error surface; WCAG AA and AAA for normal text."
    }
  ]
}